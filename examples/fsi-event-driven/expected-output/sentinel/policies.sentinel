import "tfplan/v2" as tfplan
import "tfrun"

# ============================================================
# Encryption at rest — PCI-DSS 3.4
# All storage resources must enable server-side encryption.
# ============================================================

encryption_aws_ebs_volume_violations = filter tfplan.resource_changes as _, rc {
  rc.type is "aws_ebs_volume" and
  rc.change.after.encrypted is not true
}

encryption_aws_db_instance_violations = filter tfplan.resource_changes as _, rc {
  rc.type is "aws_db_instance" and
  rc.change.after.storage_encrypted is not true
}

# TODO(aws-sme): ratify S3 server-side encryption (aws_s3_bucket_server_side_encryption_configuration — provider v4+)

rule "enforce_encryption_at_rest" {
  condition = length(encryption_aws_ebs_volume_violations) is 0 and
              length(encryption_aws_db_instance_violations) is 0
  enforcement_level = "hard-mandatory"
}

# ============================================================
# No public endpoints — PCI-DSS 1.3
# PCI-scoped workloads must not expose public ingress.
# ============================================================

public_aws_db_instance_violations = filter tfplan.resource_changes as _, rc {
  rc.type is "aws_db_instance" and
  rc.change.after.publicly_accessible is true
}

public_aws_lb_violations = filter tfplan.resource_changes as _, rc {
  rc.type is "aws_lb" and
  rc.change.after.internal is not true
}

# TODO(aws-sme): ratify security-group ingress from 0.0.0.0/0 (aws_security_group — iterate ingress rules)

rule "deny_public_endpoints" {
  condition = length(public_aws_db_instance_violations) is 0 and
              length(public_aws_lb_violations) is 0
  enforcement_level = "hard-mandatory"
}

# ============================================================
# Cost governance — budget thresholds
# Application: trade-pipeline
# ============================================================

rule "cost_advisory" {
  condition = decimal(tfrun.cost_estimate.delta_monthly_cost) < 500
  enforcement_level = "advisory"
}

rule "cost_soft_limit" {
  condition = decimal(tfrun.cost_estimate.delta_monthly_cost) < 5000
  enforcement_level = "soft-mandatory"
}

rule "cost_hard_limit" {
  condition = decimal(tfrun.cost_estimate.delta_monthly_cost) < 25000
  enforcement_level = "hard-mandatory"
}

# ============================================================
# Tagging requirements — confidential data classification
# All resources must carry data-classification tag.
# ============================================================

tagging_violations = filter tfplan.resource_changes as _, rc {
  rc.change.after.tags is not null and
  rc.change.after.tags does not contain "data-classification"
}

rule "require_data_classification_tag" {
  condition = length(tagging_violations) is 0
  enforcement_level = "hard-mandatory"
}
