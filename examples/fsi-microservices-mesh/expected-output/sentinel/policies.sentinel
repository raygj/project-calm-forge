import "tfplan/v2" as tfplan
import "tfrun"

# ============================================================
# Encryption at rest — PCI-DSS 3.4
# All storage resources must enable server-side encryption.
# ============================================================

encryption_violations = filter tfplan.resource_changes as _, rc {
  rc.type is "azurerm_storage_account" and
  rc.change.after.enable_https_traffic_only is not true
}

storage_encryption_violations = filter tfplan.resource_changes as _, rc {
  rc.type is "azurerm_managed_disk" and
  (rc.change.after.encryption_settings is null or
   rc.change.after.encryption_settings.enabled is not true)
}

rule "enforce_encryption_at_rest" {
  condition = length(encryption_violations) is 0 and
              length(storage_encryption_violations) is 0
  enforcement_level = "hard-mandatory"
}

# ============================================================
# No public endpoints — PCI-DSS 1.3
# PCI-scoped workloads must not expose public ingress.
# ============================================================

public_ingress_violations = filter tfplan.resource_changes as _, rc {
  rc.type is "kubernetes_ingress_v1" and
  rc.change.after.metadata[0].annotations["kubernetes.io/ingress.class"] is "public"
}

public_lb_violations = filter tfplan.resource_changes as _, rc {
  rc.type is "kubernetes_service_v1" and
  rc.change.after.spec[0].type is "LoadBalancer" and
  (rc.change.after.metadata[0].annotations["service.beta.kubernetes.io/azure-load-balancer-internal"] is not "true")
}

rule "deny_public_endpoints" {
  condition = length(public_ingress_violations) is 0 and
              length(public_lb_violations) is 0
  enforcement_level = "hard-mandatory"
}

# ============================================================
# Cost governance — budget thresholds
# Application: digital-banking-platform
# ============================================================

rule "cost_advisory" {
  condition = decimal(tfrun.cost_estimate.delta_monthly_cost) < 500
  enforcement_level = "advisory"
}

rule "cost_soft_limit" {
  condition = decimal(tfrun.cost_estimate.delta_monthly_cost) < 5000
  enforcement_level = "soft-mandatory"
}

rule "cost_hard_limit" {
  condition = decimal(tfrun.cost_estimate.delta_monthly_cost) < 25000
  enforcement_level = "hard-mandatory"
}

# ============================================================
# Tagging requirements — confidential data classification
# All resources must carry data-classification tag.
# ============================================================

tagging_violations = filter tfplan.resource_changes as _, rc {
  rc.change.after.tags is not null and
  rc.change.after.tags does not contain "data-classification"
}

rule "require_data_classification_tag" {
  condition = length(tagging_violations) is 0
  enforcement_level = "hard-mandatory"
}
